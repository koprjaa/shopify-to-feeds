[Unit]
Description=Shopify Feed API Service for listnato.cz
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/listnato
Environment="DOMAIN=listnato.cz"
# Security (see shopify_to_feeds/security.py):
#
#   FEED_API_KEY       REQUIRED. The /feed/* endpoints fail closed (503) while
#                      it is unset, so the service is never exposed unguarded.
#                      Deliberately not set here: a placeholder committed to the
#                      repository would be a publicly known key. Put the real
#                      secret in a drop-in that is not version controlled:
#                        systemctl edit shopify-feed
#                        [Service]
#                        Environment="FEED_API_KEY=<openssl rand -hex 32>"
#
#   FEED_ALLOWED_HOSTS Comma-separated host suffixes allowed for fetching, on
#                      top of *.myshopify.com. A custom store domain must be
#                      listed here or its fetches are rejected.
Environment="FEED_ALLOWED_HOSTS=listnato.cz,listnato.myshopify.com"
ExecStart=/usr/local/bin/uwsgi --ini uwsgi.ini
Restart=always
StandardOutput=append:/var/log/listnato/api.log
StandardError=append:/var/log/listnato/api.error.log

[Install]
WantedBy=multi-user.target
